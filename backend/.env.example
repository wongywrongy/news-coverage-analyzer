# ClearSignal Backend -- Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# ── Required ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ── Optional ─────────────────────────────────────────────────
NEWSDATA_API_KEY=your-newsdata-api-key

# ── Models (defaults shown) ──────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-20250514
HAIKU_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# ── Embedding mode ───────────────────────────────────────────
# "openai" = OpenAI text-embedding-3-small (fast, costs $)
# "local"  = sentence-transformers all-MiniLM-L6-v2 (free, slower)
EMBEDDING_MODE=openai

# ── Pipeline ─────────────────────────────────────────────────
ANALYSIS_BATCH_SIZE=10
MAX_STORIES_PER_ANALYSIS_CYCLE=8
SELECTION_ENABLED=true
LOG_LEVEL=INFO
